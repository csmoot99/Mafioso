--- bin/fm-codex-browser.sh	2026-10-22 10:19:09.981769945 -0400
+++ /tmp/fmcb-live.8ayW/patched.sh	2026-10-22 10:27:26.770987206 -0400
@@ -27,17 +27,22 @@
     chrome-devtools-axi stop >/dev/null 2>&1 || true
   fi
   if [ -n "$browser_pid" ]; then
-    kill "$browser_pid" 2>/dev/null || true
+    # Chromium's helpers outlive its main process; stop the whole group.
+    kill -- "-$browser_pid" 2>/dev/null || kill "$browser_pid" 2>/dev/null || true
     wait "$browser_pid" 2>/dev/null || true
+    for ((attempt = 0; attempt < 50; attempt++)); do
+      kill -0 -- "-$browser_pid" 2>/dev/null || break
+      sleep 0.1
+    done
   fi
-  rm -rf -- "$scratch"
+  rm -rf -- "$scratch" 2>/dev/null || true
 }
 trap cleanup EXIT
 trap 'exit 130' INT
 trap 'exit 143' TERM
 trap 'exit 129' HUP
 
-"$browser" --headless=new --no-sandbox --use-mock-keychain --password-store=basic \
+setsid "$browser" --headless=new --no-sandbox --use-mock-keychain --password-store=basic \
   --remote-debugging-address=127.0.0.1 --remote-debugging-port=0 \
   --user-data-dir="$scratch/profile" >"$scratch/chromium.log" 2>&1 &
 browser_pid=$!
